# OpenAI-compatible API Configuration
# Works with a real OpenAI key, or an OpenRouter key (recommended for a
# bootcamp session - one key can be issued to every participant). Same
# variable name either way.
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Leave unset to talk to OpenAI directly. Set to route through an
# OpenAI-API-compatible provider instead - config/llm_config.yaml is
# currently set up for OpenRouter, which needs this exact URL and
# provider-namespaced model names (e.g. "openai/gpt-4").
LLM_BASE_URL=https://openrouter.ai/api/v1

# LLM Configuration
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
MAX_TOKENS=800

# Vector store: "faiss" (default) or "chroma". Explorer page 4 and Activity 2.1
# both read this; switch it to compare the two backends on the same corpus.
# faiss is the default because chromadb's native Rust binding has no Python
# 3.14 wheel yet (as of chromadb 1.5.9, its latest PyPI release) and fails on
# any 3.14 machine. faiss-cpu already ships a cp314 wheel and has no such ABI
# dependency. Set this to "chroma" if you want to try it on Python <=3.13.
VECTOR_STORE=faiss
VECTOR_STORE_DIR=vector_store

# Application Configuration
APP_NAME=Enterprise Knowledge System
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# LangSmith Observability (Activity 3.1 - two env vars plus one traced entry point)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=enterprise-knowledge-system

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
